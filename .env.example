# usage-puller configuration template.
#
#   cp .env.example .env      # then fill in the values you have
#   python check_usage.py     # .env is auto-loaded from the working directory
#
# Every variable is optional. A provider with no credentials reports
# `Status: UNCONFIGURED (...)` and the other providers still report normally.
# Generate a filled-in copy automatically with:
#   python extract_tokens.py --reveal --format env > .env
#
# NEVER commit a real .env — it is already listed in .gitignore.


# =====================================================================
# Anthropic — Claude Code (includes the Claude Fable 5 sub-pool)
# =====================================================================

# Long-lived OAuth refresh token used by the Claude Code CLI.
# Found in ~/.claude/.credentials.json -> claudeAiOauth.refreshToken
# This is the value to store as the CLAUDE_REFRESH_TOKEN GitHub secret.
CLAUDE_REFRESH_TOKEN=

# Optional: organisation UUID. Enables the
# /v1/organizations/{org_id}/usage fallback if /api/oauth/usage changes.
CLAUDE_ORG_ID=

# Optional: short-lived access token. Useful for a one-off local run when you
# do not want to hand over a refresh token. Expires within hours — do not put
# this in GitHub Secrets.
CLAUDE_ACCESS_TOKEN=

# Optional overrides. Only set these if Anthropic changes the CLI OAuth client
# id or you are pointing at a proxy.
# CLAUDE_OAUTH_CLIENT_ID=
# ANTHROPIC_USAGE_BASE_URL=https://api.anthropic.com

# Optional: non-standard credential file location.
# CLAUDE_CREDENTIALS_PATH=~/.claude/.credentials.json


# =====================================================================
# OpenAI — Codex
# =====================================================================

# API key from https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Optional: required when the key can see more than one organisation.
OPENAI_ORG_ID=

# Optional: recommended for project-scoped (sk-proj-...) keys.
OPENAI_PROJECT_ID=

# Optional: alternate base URL (Azure gateway, proxy, local mock).
# OPENAI_BASE_URL=https://api.openai.com

# Optional: non-standard Codex CLI config location.
# CODEX_CONFIG_PATH=~/.codex/auth.json


# =====================================================================
# Google — Antigravity (agy) via Vertex AI quota
# =====================================================================

# Service account JSON. Three accepted forms:
#   1. the full JSON document on one line  {"type":"service_account",...}
#   2. base64 of that JSON
#   3. a filesystem path to the .json key file
# Needed roles: roles/serviceusage.serviceUsageViewer + roles/monitoring.viewer
GCP_SERVICE_ACCOUNT_JSON=

# Project whose aiplatform.googleapis.com quota is reported. Inferred from the
# service account's project_id when omitted.
GCP_PROJECT_ID=

# Optional: use Application Default Credentials instead of the JSON above.
# GOOGLE_APPLICATION_CREDENTIALS=~/.config/gcloud/application_default_credentials.json

# Optional: pin the reported daily tier instead of deriving it from consumption.
# Accepts any label, e.g. Normal / Reduced / Exhausted.
# AGY_TIER_OVERRIDE=

# Optional: Cloud Monitoring look-back window for quota peaks (default 24).
# AGY_LOOKBACK_HOURS=24


# =====================================================================
# Shared behaviour
# =====================================================================

# Per-request HTTP timeout in seconds. Clamped to 3-60, default 10.
# USAGE_HTTP_TIMEOUT=10
